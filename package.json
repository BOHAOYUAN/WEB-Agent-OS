{
  "name": "web-os-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn AI web UIs into agent runtimes — an external, decoupled middleware. Step 1: sensor layer.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "watch": "node scripts/build.mjs --watch",
    "demo": "node apps/demo/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "arch": "node scripts/arch-check.mjs",
    "memory:summary": "node scripts/memory-summary.mjs",
    "actor:start": "npm run build && node dist/actor-cli.js",
    "verify": "npm run typecheck && npm run lint && npm run arch && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}