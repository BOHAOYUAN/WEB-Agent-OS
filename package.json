{
  "name": "web-os-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first agent runtime for the AI web — observe, remember, act, in your own browser.",
  "repository": {
    "type": "git",
    "url": "https://github.com/BOHAOYUAN/WEB-Agent-OS.git"
  },
  "homepage": "https://github.com/BOHAOYUAN/WEB-Agent-OS#readme",
  "bugs": {
    "url": "https://github.com/BOHAOYUAN/WEB-Agent-OS/issues"
  },
  "keywords": [
    "ai-agent",
    "browser-extension",
    "local-first",
    "privacy",
    "mcp",
    "ai-chat",
    "chrome-extension"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "watch": "node scripts/build.mjs --watch",
    "demo": "node apps/demo/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/build-artifact-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "arch": "node scripts/arch-check.mjs",
    "memory:summary": "node scripts/memory-summary.mjs",
    "probe:memory": "node ./node_modules/vite-node/vite-node.mjs scripts/probe-memory-summary.mts",
    "verify:sqlite": "node --disable-warning=ExperimentalWarning scripts/verify-sqlite.mjs",
    "actor:start": "npm run build && node --disable-warning=ExperimentalWarning dist/actor-cli.js",
    "verify": "npm run typecheck && npm run lint && npm run arch && npm run test && npm run build",
    "verify:pageact-dom": "node ./node_modules/vite-node/vite-node.mjs scripts/verify-pageact-dom.ts",
    "verify:artifact": "node ./node_modules/vite-node/vite-node.mjs scripts/verify-artifact-runtime.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1"
  }
}
