{
  "manifest_version": 3,
  "name": "Web-OS-Agent Sensor",
  "version": "0.1.0",
  "description": "Read-only sensor layer for AI web UIs. Experimental; use your own account.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Web-OS-Agent sensor console"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; child-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';"
  },
  "sandbox": {
    "pages": [
      "artifact-sandbox.html"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "sensor-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "sensor-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "pageact-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
